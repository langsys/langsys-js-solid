# Playground credentials (example/ — run with `npm run dev`). Copy to `.env`.
# Use a READ-ONLY key in anything browser-shipped; a write key only in a local
# clone, to watch discovery register your phrases.
VITE_LANGSYS_PROJECT_ID=your-project-id-here
VITE_LANGSYS_API_KEY=your-api-key-here

# Optional: point the SDK at a non-production instance for local development.
# Leave unset in production — it defaults to https://api.langsys.dev/api.
# VITE_LANGSYS_API_URL=http://langsys-nova.test/api
